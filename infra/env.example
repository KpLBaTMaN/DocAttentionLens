# Local CPU deployment. Copy to infra/.env and pass --env-file infra/.env if overriding.
# URI-encode special characters in DOCATTENTIONLENS_DB_PASSWORD when used in DOCATTENTIONLENS_DATABASE_URL.
DOCATTENTIONLENS_DB_PASSWORD=docattentionlens-local-only
# Native processes use these; Compose supplies its own internal paths.
DOCATTENTIONLENS_DATABASE_URL=postgresql://docattentionlens:docattentionlens-local-only@127.0.0.1:5432/docattentionlens
DOCATTENTIONLENS_ARTIFACT_ROOT=var/artifacts
DOCATTENTIONLENS_DATA_ROOT=data
DOCATTENTIONLENS_WORKER_RESOURCE_CLASS=cpu
DOCATTENTIONLENS_WORKER_CONCURRENCY=1

DOCATTENTIONLENS_MODEL_CACHE=var/model-cache
# Compose --profile gpu selects resource class gpu in a separate worker.
# Optional: job lease in seconds (at least 10; workers renew every third of it).
# DOCATTENTIONLENS_LEASE_SECONDS=30
# Optional: file where a worker records its ID for `python -m docattentionlens_worker.health` (default: <temp dir>/docattentionlens-worker-id).
# DOCATTENTIONLENS_WORKER_ID_FILE=var/docattentionlens-worker-id
